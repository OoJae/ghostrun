{"op":"verb","id":"vb_look_sun","verb":"social.inspect","on":"sun_body","params":{"text":"The Sun holds about 99.8% of the solar system's mass."}}
{"op":"verb","id":"vb_look_mercury","verb":"social.inspect","on":"mercury","params":{"text":"Mercury is the smallest planet and orbits closest to the Sun."}}
{"op":"verb","id":"vb_look_venus","verb":"social.inspect","on":"venus","params":{"text":"Venus is the hottest planet, held in by a thick carbon dioxide atmosphere."}}
{"op":"verb","id":"vb_look_earth","verb":"social.inspect","on":"earth","params":{"text":"Earth is the only known world with liquid water on its surface."}}
{"op":"verb","id":"vb_look_mars","verb":"social.inspect","on":"mars","params":{"text":"Mars has the tallest volcano known, Olympus Mons, about three times Everest's height."}}
{"op":"verb","id":"vb_look_jupiter","verb":"social.inspect","on":"jupiter_body","params":{"text":"Jupiter is the largest planet; more than 1,300 Earths would fit inside it."}}
{"op":"verb","id":"vb_look_saturn","verb":"social.inspect","on":"saturn_body","params":{"text":"Saturn's rings are mostly ice and are over 270,000 km wide."}}
{"op":"verb","id":"vb_look_uranus","verb":"social.inspect","on":"uranus_body","params":{"text":"Uranus spins on its side, tilted about 98 degrees."}}
{"op":"verb","id":"vb_look_neptune","verb":"social.inspect","on":"neptune_body","params":{"text":"Neptune has the strongest winds in the solar system, over 2,000 km/h."}}
