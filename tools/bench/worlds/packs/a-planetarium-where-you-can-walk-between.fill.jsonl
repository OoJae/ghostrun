{"op":"verb","id":"vb_info_belt","verb":"social.inspect","on":"belt_panel","params":{"text":"The asteroid belt: rocky remnants lying between Mars and Jupiter."}}
{"op":"verb","id":"vb_info_jupiter","verb":"social.inspect","on":"jupiter_plinth","params":{"text":"Jupiter: the largest planet, more than twice the mass of all the others combined."}}
{"op":"verb","id":"vb_info_saturn","verb":"social.inspect","on":"saturn_plinth","params":{"text":"Saturn: famous for its bright rings, mostly made of ice."}}
